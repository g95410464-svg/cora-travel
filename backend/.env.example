OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=
PORT=3000
AI_TIMEOUT_MS=20000
RATE_LIMIT_MAX=30

# Google OAuth web flow for the CORA mobile app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: https://your-cora-api.up.railway.app/auth/google/callback
GOOGLE_REDIRECT_URI=
MOBILE_AUTH_REDIRECT_URI=cora://auth/callback
# Use a long random value in production so app sessions survive server restarts.
AUTH_SESSION_SECRET=
